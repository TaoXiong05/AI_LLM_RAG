# Postgres（已有的、装好 pgvector 扩展的实例）
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ragdb
PG_USER=postgres
PG_PASSWORD=changeme
PG_SSLMODE=prefer

# LLM / Embedding —— OpenAI 兼容接口（默认值与 03RAG_Demo.py 一致，阿里云百炼）
OPENAI_BASE_URL=https://ws-wibk6xl3op0zm1sx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAT_MODEL=qwen3.8-max
EMBED_MODEL=text-embedding-v3
# OCR 专用视觉模型（扫描版 PDF / 文档内图片 / 纯图片）
OCR_MODEL=gemini-3.5-flash

# App
COLLECTION_NAME=rag_default_kb
TOP_K=3
# 检索结果相关度阈值：pgvector 余弦距离（越小越相关）。距离达到阈值的片段
# 视为低质量结果，不再作为引用展示（避免"模型未找到相关资料却仍显示引用"）。
RETRIEVAL_MAX_DISTANCE=0.8
# 清空知识库需要输入的密码，自行修改成你自己的
CLEAR_KB_PASSWORD=changeme
